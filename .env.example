# ---------------------------------------------------------------------------
# Steal My Flow — environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# --- Supabase (public — safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only — NEVER expose to the client) ---
# Used by admin/server actions that must bypass RLS (e.g. seeding).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (server only) ---
# Swappable: AI_PROVIDER = anthropic (default) | gemini | openai
AI_PROVIDER=gemini

# Claude (Anthropic) — paid
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini — has a free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI — paid
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
