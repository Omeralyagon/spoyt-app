# ---------------------------------------------------------------------------
# Steal My Flow — environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# --- Supabase (public — safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only — NEVER expose to the client) ---
# Used by admin/server actions that must bypass RLS (e.g. seeding).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (server only) ---
# Default provider is Claude (Anthropic). Swappable: set AI_PROVIDER=openai to use OpenAI.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
